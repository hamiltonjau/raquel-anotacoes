# Copie este arquivo para `.env` (que não vai para o git) e ajuste se precisar.
# Sem nada aqui o app já funciona: usa credentials/service-account.json e
# procura a planilha chamada "Anotações".

# Caminho do JSON da conta de serviço (robô).
# SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Nome da planilha no Drive (se você renomear a planilha, mude aqui).
# ANOTACOES_PLANILHA=Anotações da Raquel

# 0 = não forçar IPv4 (só use se a rede mudar).
# ANOTACOES_IPV4=1
