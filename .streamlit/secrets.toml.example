# MODELO dos segredos do app Anotações da Raquel.
# Copie para `.streamlit/secrets.toml` (no PC) e preencha com os valores reais.
# Na nuvem (Streamlit Cloud): Settings > Secrets — cole o arquivo INTEIRO.
# Este arquivo de modelo PODE ir para o git (não tem valor nenhum de verdade).

# Senha de entrada. Não é para ficar no código nem no handoff.
# ⚠️ A senha tem de vir ANTES das seções, senão o TOML a coloca dentro da última.
senha = "000000"

# Conta de serviço (o "robô") — é ela que lê e escreve a planilha.
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "loja-robo@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."

# Token do DONO (hamiltonjau@gmail.com) para ENVIAR FOTO ao Drive.
# Conta de serviço não pode ser dona de arquivo (403 "storage quota"), então
# quem sobe foto é gente. O conteúdo vem de `credentials/token-fotos.json`
# (gerado por `autorizar-fotos.py`). Atalho: `./.venv/bin/python preparar-nuvem.py`
# imprime este bloco já preenchido.
[google_oauth]
refresh_token = "..."
token = "..."
token_uri = "https://oauth2.googleapis.com/token"
client_id = "..."
client_secret = "..."
scopes = ["https://www.googleapis.com/auth/drive"]
